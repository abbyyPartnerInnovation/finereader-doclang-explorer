<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <FineReaderInteropPath Condition="'$(FineReaderInteropPath)' == ''">$(MSBuildThisFileDirectory)..\..\vendor\FREngine.DotNet.Interop.dll</FineReaderInteropPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FREngine.DotNet.Interop">
      <HintPath>$(FineReaderInteropPath)</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
    <Content Remove="wwwroot\**\*" />
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>
  <Target Name="CheckFineReaderInterop" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(FineReaderInteropPath)')">
    <Error Text="Run .\tools\Setup-FineReader.ps1 to copy the installed FineReader 12.8.2 .NET wrapper into this solution's vendor folder. See README.md." />
  </Target>
</Project>
